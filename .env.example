# Local-first defaults — mock provider needs no cloud keys.
AIWB_LLM_PROVIDER=mock
AIWB_API_KEY=dev-workbench-key
AIWB_RATE_LIMIT_PER_MINUTE=120
# AIWB_REQUIRE_APPROVAL=false

# Optional cloud providers (only used when AIWB_LLM_PROVIDER matches and key is set)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Paths (defaults work from repo root)
# AIWB_CORPUS_DIR=data/corpus
# AIWB_DB_PATH=data/runtime/workbench.db
# AIWB_PROMPTS_DIR=prompts
# AIWB_GOLDEN_PATH=data/golden/rag_cases.jsonl
